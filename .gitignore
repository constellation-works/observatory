# Bytes are never committed, manifests always are.
_data/**
!_data/**/
!_data/README.md
!_data/**/manifest.json
**/data/**
!**/data/**/
!**/data/manifest.json
!**/data/README.md
**/output/**
!**/output/**/
!**/output/README.md

# _archive is frozen history: it keeps whatever it was committed with.
!_archive/**

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.mypy_cache/

# Secrets and local env
.env
.env.*
!.env.example

# Orbit runtime state
.orbit/state/
.orbit/tasks/

# OS
.DS_Store
.orbit/*
!.orbit/auto_tasks/
!.orbit/resources/
!.orbit/routines/
!.orbit/config.toml
.orbit/**/*.lock
